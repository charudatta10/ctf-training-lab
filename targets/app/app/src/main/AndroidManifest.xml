<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.GlowMart">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M1-C1: exported component with a hidden flag in meta-data -->
        <activity
            android:name=".SecretActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <meta-data
                android:name="com.glowmart.mobile.flag"
                android:value="flag{manifest_exported_leak}" />
        </activity>

        <!-- M1-C2: exported debug activity that leaks data via intent extras -->
        <activity
            android:name=".DebugLeakActivity"
            android:exported="true"
            android:theme="@style/Theme.GlowMart.Dialog" />

        <!-- M1-C4: unprotected exported content provider -->
        <provider
            android:name=".FlagProvider"
            android:authorities="com.glowmart.mobile.secrets"
            android:exported="true" />

        <!-- M3-C11/C12: vault screen with root detection + runtime decrypt -->
        <activity
            android:name=".VaultActivity"
            android:exported="true" />

    </application>
</manifest>