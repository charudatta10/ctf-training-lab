# ============================================================================
# mobsec-ctf-lab - environment configuration
# Copy this file to `.env` and adjust values as needed.
#   cp .env.example .env          (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
# ============================================================================

# --- Host binding -----------------------------------------------------------
# Keep to 127.0.0.1 for LOCAL-ONLY access. Change ONLY if you intend to
# expose CTFd to your LAN (instructor decision - NOT recommended by default).
CTFD_BIND_ADDR=127.0.0.1
CTFD_BIND_PORT=8000

# --- Target exposure (OPTIONAL, OFF by default) ------------------------------
# The mobile-labs targets (appstore, api) are isolated on the internal
# network by default. The api is additionally bound to the host loopback so
# the Android emulator (10.0.2.2) can reach it during dynamic-analysis labs.
# To enable the SINGLE ENTRY reverse proxy for a classroom, set EXPOSE_TARGETS=1.
# WARNING: this reaches anyone on your network. Leave 0 unless you need it.
EXPOSE_TARGETS=0
# Bind exposed ports to all interfaces (0.0.0.0) or a specific LAN IP.
# TARGET_BIND_ADDR=0.0.0.0
# Single HTTP entry point (the only broadly-exposed port).
PROXY_PORT=8080
# Students use hostnames like appstore.<SERVICE_DOMAIN>. Set to "<LAN-IP>.sslip.io".
# Using sslip.io means students need no hosts-file / DNS edits.
SERVICE_DOMAIN=10.0.0.1.sslip.io

# --- Mobile backend API (the app under test talks to this) ------------------
# Loopback by default so the emulator can reach it via 10.0.2.2 without LAN
# exposure. API_BIND_ADDR is overridden to 0.0.0.0 when EXPOSE_TARGETS=1.
API_BIND_ADDR=127.0.0.1
API_BIND_PORT=3000        # plain HTTP (emulator endpoint)
API_HTTPS_PORT=3443       # pinned-TLS endpoint (Module 3 SSL-pinning lab)

# --- CTFd configuration ----------------------------------------------------
CTFD_CTF_NAME=Mobile Security CTF Lab 2026 - GlowMart Mobile
CTFD_CTF_DESCRIPTION=A local, isolated mobile app security course lab (Android).
CTFD_MODE=teams
CTFD_WORKERS=1

# Generate a strong random value and keep it secret.
CTFD_SECRET_KEY=change-me-mobsec-lab-secret
CTFD_DATABASE_URL=mysql+pymysql://ctfd:ctfd_pw@db:3306/ctfd
CTFD_REDIS_URL=redis://cache:6379

# Admin bootstrapped by the CLI provisioner (scripts/lab.py start); change after first login.
CTFD_ADMIN_EMAIL=instructor@lab.local
CTFD_ADMIN_PASSWORD=ChangeMe-Admin-2026

# --- Database --------------------------------------------------------------
MYSQL_ROOT_PASSWORD=ctfd_root_pw
MYSQL_USER=ctfd
MYSQL_PASSWORD=ctfd_pw
MYSQL_DATABASE=ctfd